# FIA Source
FIA_CATALOG_URL=https://www.fia.com/regulation/category/110
FIA_BASE_URL=https://www.fia.com

# Qdrant
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=f1_regulations_minilm

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=256

# Reranker
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
ENABLE_RERANKER=false

# Ollama / LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# Chunking
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=32

# System
DEFAULT_SEASON=2026
DATA_DIR=data
DB_PATH=data/source_registry.db
LOG_LEVEL=INFO

# Updates
QDRANT_LOCK_WAIT_SECONDS=30
UPDATE_INTERVAL_HOURS=20
LOG_DIR=logs
